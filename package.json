{
  "name": "@devdengchao/opencode-plugin-show-agent-response-time",
  "version": "0.1.0",
  "description": "Show the exact completion time of agent responses in OpenCode Desktop sessions",
  "license": "MIT",
  "author": "DevDengChao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevDengChao/opencode-plugin-show-agent-response-time.git"
  },
  "homepage": "https://github.com/DevDengChao/opencode-plugin-show-agent-response-time#readme",
  "bugs": {
    "url": "https://github.com/DevDengChao/opencode-plugin-show-agent-response-time/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-desktop",
    "session",
    "response-time",
    "response-completion-time",
    "agent-response",
    "timestamp",
    "typescript",
    "gui-plugin"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui.cjs"
  },
  "files": [
    "src",
    "dist",
    "docs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "demo": "vite --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^27.4.0",
    "solid-js": "^1.9.17",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.12"
  }
}
